# ============================================================================
# config.env — NGUỒN SỰ THẬT DUY NHẤT cho đường dẫn DỮ LIỆU + ngôn ngữ.
# Stage: AUDIO-ONLY ACQUISITION (W1–W8).
#
# Quy tắc:
#   1. Dữ liệu crawl/derive KHÔNG nằm trong repo — repo chỉ chứa code.
#   2. Mọi biến dùng ${VAR:-default}  =>  biến môi trường ngoài LUÔN override được.
#   3. Các script `source` file này: crawler/crawl_all.sh, run_pipeline.sh, cron/*.
#      Python đọc cùng giá trị qua metadata/paths.py (giữ 2 bên đồng bộ).
#   4. TUYỆT ĐỐI không đặt secret (token HF, cookie, PAT) trong file này.
#      Cần override cục bộ theo máy? Tạo config.local.env (đã nằm trong .gitignore)
#      rồi `set -a; . ./config.local.env; set +a` trước khi chạy.
#
# >>> ĐỔI NGÔN NGỮ: sửa LANG_CODE / ACCEPT_LANGS / ISO_639_2, thêm danh sách kênh
#     (crawler/channels.txt) và từ khoá discovery (crawler/langs/<LANG_CODE>/keywords.txt).
#     Hướng dẫn từng bước: docs/ADD_LANGUAGE.md
# ============================================================================

# --- Ngôn ngữ -----------------------------------------------------------------
# LANG_CODE = mã ISO 639-1 của ngôn ngữ CHÍNH (vi, th, id, ms, my, km, lo, ...).
# Ba biến phải khớp nhau:
#   LANG_CODE      vi        -> format selector `[language^=vi]` của yt-dlp, LID, HF card
#   ACCEPT_LANGS   vi,en     -> Whisper GIỮ các ngôn ngữ này (code-switch: chính + en)
#   ISO_639_2      vie       -> mã 3 ký tự cho forced alignment + uroman
LANG_CODE="${LANG_CODE:-vi}"
ACCEPT_LANGS="${ACCEPT_LANGS:-$LANG_CODE,en}"
ISO_639_2="${ISO_639_2:-vie}"

# --- Đường dẫn (dữ liệu luôn NGOÀI repo) --------------------------------------
# Thư mục gốc chứa toàn bộ dữ liệu (audio thô + mọi thứ phái sinh).
DATA_ROOT="${DATA_ROOT:-$HOME/data}"

# W1–W3: raw crawl (audio medium opus + *.info.json), mỗi kênh 1 thư mục con
DOWNLOAD_DIR="${DOWNLOAD_DIR:-$DATA_ROOT/download_from_youtube}"

# W4–W6: mọi thứ phái sinh (index, QC flags, batch/unit, hardlink tree)
DATASET_DIR="${DATASET_DIR:-$DATA_ROOT/dataset}"

# W5: sổ cái corpus — "trí nhớ" duy nhất của corpus (giữ cả local + remote)
LEDGER_FILE="${LEDGER_FILE:-$DATA_ROOT/corpus_ledger.jsonl}"

# Ngưỡng dung lượng staging (GB): cảnh báo khi free < MIN_FREE_GB, dừng khi free < MIN_FREE_HARD_GB
MIN_FREE_GB="${MIN_FREE_GB:-50}"
MIN_FREE_HARD_GB="${MIN_FREE_HARD_GB:-20}"

# --- Cửa sổ thời gian + mục tiêu ---------------------------------------------
# Chỉ nhận video đăng từ MIN_UPLOAD_DATE (YYYYMMDD) — kiểm ở 3 lớp:
# format selector, audit index, filter manifest.
MIN_UPLOAD_DATE="${MIN_UPLOAD_DATE:-20260101}"
# Mục tiêu dung lượng corpus (giờ) — dùng cho corpus_ledger.py report / make_unit.py
TARGET_HOURS="${TARGET_HOURS:-50000}"

# --- Tuỳ chọn CRAWL (không phải đường dẫn) -----------------------------------
# MAX_VIDEOS = số video MỚI tối đa mỗi TAB mỗi lượt (yt-dlp --max-downloads).
# Chạy 3 tab (videos/shorts/streams) => tối đa 3 x MAX_VIDEOS file mới/kênh/lượt.
# Rỗng = không giới hạn (nên tránh: dễ chạm rate-limit của YouTube).
# WALK_SLACK do crawler tự tính = MAX_VIDEOS + 20 (ĐỪNG đặt nhỏ hơn MAX_VIDEOS).
MAX_VIDEOS="${MAX_VIDEOS:-50}"

# Chốt an toàn: nếu đường dẫn download resolve vào TRONG repo → script DỪNG.
# Chỉ bật ALLOW_IN_REPO_DOWNLOAD=1 khi bạn thực sự muốn ghi dữ liệu vào repo.
ALLOW_IN_REPO_DOWNLOAD="${ALLOW_IN_REPO_DOWNLOAD:-0}"

# --- Đích upload (W6) ---------------------------------------------------------
# GDRIVE_PARENT: thư mục gốc corpus trên Google Drive (rclone remote + folder).
# GDRIVE_REMOTE: fallback cho các script cũ (upload_batch.sh / verify_remote.sh).
GDRIVE_PARENT="${GDRIVE_PARENT:-gdrive:corpus}"
GDRIVE_REMOTE="${GDRIVE_REMOTE:-$GDRIVE_PARENT}"

# HF_ORG: tài khoản/tổ chức HuggingFace mặc định (repo_id = "$HF_ORG/<unit>").
# Để trống => upload_unit_hf.py tự lấy username của token đang đăng nhập.
HF_ORG="${HF_ORG:-}"

# Bật/tắt Xet data-plane của HF. Xet có thể rất chậm từ một số mạng:
# đặt 0 để ép dùng LFS (thường nhanh hơn nhiều).
HF_HUB_DISABLE_XET="${HF_HUB_DISABLE_XET:-1}"

